# Шаблон конфигурации окружения. Скопируйте в .env и заполните значения.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=bgu_applicants
POSTGRES_USER=bgu_app
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Заголовки безопасности и cookies в HTTPS-режиме
DJANGO_COOKIE_SECURE=0
DJANGO_SECURE_SSL_REDIRECT=0
SESSION_COOKIE_AGE=1800

# MAX Bot API (токен: business.max.ru -> Чат-боты -> Настройки)
MAX_API_BASE=https://platform-api2.max.ru
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=bgu_imkn_bot
# Секрет для проверки заголовка X-Max-Bot-Api-Secret (A-Z a-z 0-9 _ -), 5..256 символов
MAX_WEBHOOK_SECRET=
MAX_AS_SECOND_FACTOR=1
